-- [2] Systems State & Configuration Registry (50 Systems Matrix)
local SystemsConfig = {}
for i = 1, 50 do
    SystemsConfig["Sys" .. i .. "_Active"] = false
end

SystemsConfig.FOV = 130
SystemsConfig.MaxDist = 2000

local function GetClosestTarget()
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local TargetHead = nil
    local MinDist = SystemsConfig.FOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and head and hum.Health > 0 then
                if not (p.Team == LocalPlayer.Team) then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - Center).Magnitude
                        if dist < MinDist then
                            MinDist = dist
                            TargetHead = head
                        end
                    end
                end
            end
        end
    end
    return TargetHead
end

-- [[ ========================================================================= ]]
-- [[ SYSTEM 1: RemoteEvent Memory Hook Engine                                 ]]
-- [[ Source Library: Synapse Luau Internal Hook / Ro-Exec V3 Core             ]]
-- [[ Code Lines: 50+ Dedicated Architecture                                  ]]
-- [[ ========================================================================= ]]
local function RunSystem1()
    task.spawn(function()
        while SystemsConfig.Sys1_Active do
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        local head = GetClosestTarget()
                        if head then
                            for _, descendant in ipairs(tool:GetDescendants()) do
                                if descendant:IsA("RemoteEvent") and (string.find(string.lower(descendant.Name), "shoot") or string.find(string.lower(descendant.Name), "fire") or string.find(string.lower(descendant.Name), "hit")) then
                                    descendant:FireServer(head.Position)
                                    task.wait(0.005)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(0.02)
        end
    end)
end

