-- [[ Core Memory & Metatable Name Spoofer ]]
-- يقوم بخداع نظام قراءة الأسماء محلياً من ملفات الذاكرة للعبة لديك أنت فقط

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- جدول لتخزين الأسماء الجديدة التي تحددها
getgenv().CustomNames = getgenv().CustomNames or {}

-- دالة لتغيير اسم أي لاعب جذرياً من الذاكرة المحلية
local function spoofPlayer(targetPlayer, fakeName, fakeUser)
	getgenv().CustomNames[targetPlayer] = {
		Name = fakeUser or targetPlayer.Name,
		DisplayName = fakeName or targetPlayer.DisplayName
	}
end

-- تفعيل خطاف الذاكرة (Metatable Hook) لمنع اللعبة من جلب الأسماء الحقيقية
local mt = getrawmetatable(game)
setreadonly(mt, false)

local oldIndex = mt.__index

mt.__index = newcclosure(function(self, index)
	-- التحقق مما إذا كان الكائن هو لاعب ويتم طلب اسمه أو يوزره
	if typeof(self) == "Instance" and self:IsA("Player") then
		if getgenv().CustomNames[self] then
			if index == "Name" then
				return getgenv().CustomNames[self].Name
			elseif index == "DisplayName" then
				return getgenv().CustomNames[self].DisplayName
			end
		end
	end
	return oldIndex(self, index)
end)

setreadonly(mt, true)

-- مثال عملي لتطبيق التعديل على أول لاعب تجده في السيرفر (غير القيم باللي تبغاه)
task.spawn(function()
	task.wait(1)
	local target = Players:GetPlayers()[2] -- اللاعب الثاني في السيرفر مثلاً
	if target then
		-- ضع هنا الاسم الجديد واليوزر الجديد الذي تريده أن يُقرأ من ملفات جهازك
		spoofPlayer(target, "الاسم_الجديد", "Username_New")
		print("تم تعديل ملفات وقراءة اسم اللاعب محلياً بنجاح!")
	end
end)
