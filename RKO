---------------------------------------------------------
-- TARGET LOCK & HITFIX ENGINE
---------------------------------------------------------
local function GetClosestTarget()
    if LockedTarget and LockedTarget.Parent and LockedTarget.Parent:FindFirstChildOfClass("Humanoid") then
        if LockedTarget.Parent.Humanoid.Health > 0 then
            return LockedTarget
        end
    end

    local closestPart = nil
    local shortestDist = 200 -- نطاق الكشف (FOV Radius)
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local part = char:FindFirstChild(getgenv().AimSettings.TargetPart)
                if part then
                    local targetWorldPos = part.Position + getgenv().AimSettings.OffsetY + (part.AssemblyLinearVelocity * getgenv().AimSettings.Prediction)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetWorldPos)
                    
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestPart = part
                        end
                    end
                end
            end
        end
    end
    LockedTarget = closestPart
    return LockedTarget
end

-- حلقة التثبيت المانعة لانحراف الرصاص
RunService.RenderStepped:Connect(function()
    if getgenv().AimSettings.Enabled then
        local targetPart = GetClosestTarget()
        if targetPart then
            local finalPos = targetPart.Position + getgenv().AimSettings.OffsetY + (targetPart.AssemblyLinearVelocity * getgenv().AimSettings.Prediction)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, finalPos)
        end
    else
        LockedTarget = nil
    end
end)

