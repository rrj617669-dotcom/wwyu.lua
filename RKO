    else
        ToggleBtn.Text = "🔴 Auto Fire: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
    end
end)

-- Single Shot Control
SingleShotBtn.MouseButton1Click:Connect(function()
    ActivateTool()
end)

-- Main Loop
task.spawn(function()
    while true do
        if getgenv().AutoFireEnabled then
            ActivateTool()
        end
        task.wait(getgenv().FireDelay)
    end
end)
