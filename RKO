-- دالة البحث عن الملفات وعرضها
local function LoadFileList()
    -- تنظيف القائمة القديمة
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local foundFiles = {}
    if listfiles then
        local success, files = pcall(function()
            return listfiles("")
        end)
        if success and files then
            for _, filePath in ipairs(files) do
                if string.match(filePath, "%.rbxm$") then
                    table.insert(foundFiles, filePath)
                end
            end
        end
    end

    if #foundFiles == 0 then
        local noFileLbl = Instance.new("TextLabel")
        noFileLbl.Size = UDim2.new(1, 0, 0, 40)
        noFileLbl.BackgroundTransparency = 1
        noFileLbl.Text = "ما فيه ملفات rbxm في مجلد المنفذ!"
        noFileLbl.TextColor3 = Color3.fromRGB(200, 100, 100)
        noFileLbl.TextSize = 14
        noFileLbl.Font = Enum.Font.SourceSans
        noFileLbl.Parent = scrollFrame
        return
    end

    for _, filePath in ipairs(foundFiles) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 40)
        btn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        btn.Text = filePath
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 13
        btn.Font = Enum.Font.SourceSans
        btn.Parent = scrollFrame

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        -- الحدث عند الضغط على الملف لرسبنته
        btn.MouseButton1Click:Connect(function()
            print("جاري محاولة رسبنة: " .. filePath)
            local success, err = pcall(function()
                -- استخدام دالة قراءة الملف واستيراده
                if readfile then
                    local content = readfile(filePath)
                    -- هنا يتم استدعاء محرك فك الملفات ورسبنتها
                    local model = game:GetService("InsertService"):LoadLocalAsset(filePath)
                    if model then
                        model.Parent = workspace
                        if model:IsA("Model") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            model:MoveTo(LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0))
                        end
                    end
                end
            end)
            if not success then
                warn("فشل الرسبنة: " .. tostring(err))
            end
        end)
    end

    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #foundFiles * 45)
end

LoadFileList()
