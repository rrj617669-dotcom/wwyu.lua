-- [[ SYSTEM 1: RemoteEvent Memory Hook Engine                                 ]]
-- [[ Source Library: Synapse Luau Internal Hook / Ro-Exec V3 Core             ]]
-- [[ ========================================================================= ]]
local function ExecuteSystem1()
    task.spawn(function()
        while MasterConfig.System_1_Active do
            pcall(function()
                local character = LocalPlayer.Character
                if character then
                    local toolItem = character:FindFirstChildOfClass("Tool")
                    if toolItem then
                        local targetHead = GetOptimalHeadTarget()
                        if targetHead then
                            for _, childNode in ipairs(toolItem:GetDescendants()) do
                                if childNode:IsA("RemoteEvent") then
                                    local lowerName = string.lower(childNode.Name)
                                    if string.find(lowerName, "shoot") or string.find(lowerName, "fire") or string.find(lowerName, "hit") or string.find(lowerName, "attack") then
                                        childNode:FireServer(targetHead.Position)
                                        task.wait(0.002)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(0.01)
        end
    end)
end

