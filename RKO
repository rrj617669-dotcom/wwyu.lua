-- متغيرات التحكم والـ Settings
local Settings = {
    Enabled = false,
    MaxDistance = 150,
    MinDelay = 0.015,
    MaxDelay = 0.045,
    CheckTeam = true
}

-- الخدمات وبيئة العمل
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- دالة التحقق من الهدف
local function isValidTarget(targetPart)
    local character = targetPart.Parent
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local enemyPlayer = Players:GetPlayerFromCharacter(character)
    
    if humanoid and humanoid.Health > 0 and enemyPlayer ~= LocalPlayer then
        if Settings.CheckTeam and enemyPlayer.Team == LocalPlayer.Team then
            return false
        end
        return true
    end
    return false
end

-- دالة إطلاق النار الذكي
local function triggerShoot()
    local humanDelay = math.random(Settings.MinDelay * 1000, Settings.MaxDelay * 1000) / 1000
    task.wait(humanDelay)
    
    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            local onActivateEvent = tool:FindFirstChild("OnActivate")
            if onActivateEvent and onActivateEvent:IsA("RemoteEvent") then
                onActivateEvent:FireServer()
            else
                tool:Activate()
            end
        end
    end
end

