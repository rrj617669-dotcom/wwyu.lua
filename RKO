-- استدعاء مكتبة واجهة Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Advanced Head ESP & Triggerbot",
   LoadingTitle = "جاري تحميل النظام المحدث...",
   LoadingSubtitle = "بواسطة Expert Engine",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local Tab = Window:CreateTab("التحكم والضبط", 4483362458)

-- الإعدادات
local Settings = {
    ESPEnabled = false,
    TriggerEnabled = false,
    MaxDistance = 300,
    MinDelay = 0.005,
    MaxDelay = 0.02,
    CheckTeam = true
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local espBoxes = {}

-- دالة إنشاء الـ ESP مع دعم الموت والرجوع للحياة (Respawn Fix)
local function setupPlayerESP(player)
    if player == LocalPlayer then return end

    local function createDrawing()
        if espBoxes[player] then
            espBoxes[player]:Remove()
            espBoxes[player] = nil
        end

        local box = Drawing.new("Circle")
        box.Visible = false
        box.Color = Color3.fromRGB(255, 0, 0)
        box.Thickness = 2
        box.NumSides = 16
        box.Filled = false
        espBoxes[player] = box
    end

    createDrawing()

    player.CharacterAdded:Connect(function(newChar)
        createDrawing()
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    setupPlayerESP(p)
end

Players.PlayerAdded:Connect(setupPlayerESP)

Players.PlayerRemoving:Connect(function(p)
    if espBoxes[p] then
        espBoxes[p]:Remove()
        espBoxes[p] = nil
    end
end)

-- التحقق من صحة الهدف
local function isValidTarget(targetPart)
    local character = targetPart.Parent
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local enemyPlayer = Players:GetPlayerFromCharacter(character)
    
    if humanoid and humanoid.Health > 0 and enemyPlayer ~= LocalPlayer then
        if Settings.CheckTeam and enemyPlayer.Team == LocalPlayer.Team then
            return false
        end
        return true
    end
    return false
end

-- دالة الطلق التلقائي الفعالة
local function triggerShoot()
    local humanDelay = math.random(Settings.MinDelay * 1000, Settings.MaxDelay * 1000) / 1000
    task.wait(humanDelay)
    
    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            local onActivateEvent = tool:FindFirstChild("OnActivate")
            if onActivateEvent and onActivateEvent:IsA("RemoteEvent") then
                onActivateEvent:FireServer()
            else
                tool:Activate()
            end
        end
    end
end

-- حلقة التحديث المستمر (RenderStepped)
local debounce = false
RunService.RenderStepped:Connect(function()
    -- تحديث وإظهار الـ ESP للرأس بدقة
    for player, box in pairs(espBoxes) do
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if Settings.ESPEnabled and head and humanoid and humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local distance = (Camera.CFrame.Position - head.Position).Magnitude
                if distance <= Settings.MaxDistance then
                    box.Radius = math.clamp(1200 / distance, 4, 22)
                    box.Position = Vector2.new(vector.X, vector.Y)
                    box.Visible = true
                else
                    box.Visible = false
                end
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    end
    
    -- نظام الطلق التلقائي (Triggerbot)
    if not Settings.TriggerEnabled or debounce then return end
    
    local cameraPos = Camera.CFrame.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local lookVector = Camera.CFrame.LookVector
    local raycastResult = Workspace:Raycast(cameraPos, lookVector * Settings.MaxDistance, raycastParams)
    
    if raycastResult and raycastResult.Instance then
        local hitPart = raycastResult.Instance
        
        if hitPart.Name == "Head" and isValidTarget(hitPart) then
            debounce = true
            pcall(function()
                triggerShoot()
            end)
            task.wait(0.08)
            debounce = false
        end
    end
end)

