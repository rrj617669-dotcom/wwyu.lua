-- 1. NO RECOIL SYSTEM
local lastCameraCFrame = Camera.CFrame
RunService.RenderStepped:Connect(function()
    if getgenv().NoRecoilEnabled and getgenv().AutoFireEnabled then
        Camera.CFrame = lastCameraCFrame
    else
        lastCameraCFrame = Camera.CFrame
    end
end)

local function ClearWeaponRecoil(tool)
    local infoFolder = tool:FindFirstChild("InfoFolder")
    if infoFolder then
        for _, val in ipairs(infoFolder:GetChildren()) do
            if string.find(string.lower(val.Name), "recoil") and (val:IsA("NumberValue") or val:IsA("IntValue")) then
                val.Value = 0
            end
        end
    end
end

-- 2. TARGETED GUN MUTE
local function MuteMyWeaponOnly()
    if not getgenv().MuteShotsEnabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        for _, item in ipairs(tool:GetDescendants()) do
            if item:IsA("Sound") then
                item.Volume = 0
            end
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, bgTool in ipairs(backpack:GetChildren()) do
            if bgTool:IsA("Tool") then
                for _, item in ipairs(bgTool:GetDescendants()) do
                    if item:IsA("Sound") then
                        item.Volume = 0
                    end
                end
            end
        end
    end
end

RunService.Stepped:Connect(function()
    if getgenv().MuteShotsEnabled then
        MuteMyWeaponOnly()
    end
end)

-- 3. PRONE ANIMATION SYSTEM
local function ToggleProne()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if not isProne then
        local anim = Instance.new("Animation")
        anim.AnimationId = PRONE_ANIM_ID
        
        currentProneTrack = humanoid:LoadAnimation(anim)
        currentProneTrack.Priority = Enum.AnimationPriority.Action
        currentProneTrack:Play()
        
        isProne = true
        ProneBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 40)
    else
        if currentProneTrack then
            currentProneTrack:Stop()
            currentProneTrack = nil
        end
        isProne = false
        ProneBtn.BackgroundColor3 = Color3.fromRGB(130, 50, 200)
    end
end

-- 4. WEAPON ACTIVATION & RELOAD
local function ActivateTool()
    local character = LocalPlayer.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    if getgenv().MuteShotsEnabled then
        MuteMyWeaponOnly()
    end

    if getgenv().NoRecoilEnabled then
        ClearWeaponRecoil(tool)
    end

    pcall(function()
        tool:Activate()
    end)

    local onActivate = tool:FindFirstChild("OnActivate")
    if onActivate then
        pcall(function()
            if onActivate:IsA("RemoteEvent") then
                onActivate:FireServer()
            elseif onActivate:IsA("BindableEvent") then
                onActivate:Fire()
            end
        end)
    end
end

local function ReloadTool()
    local character = LocalPlayer.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    local ammoRemote = tool:FindFirstChild("Ammo")
    if ammoRemote then
        pcall(function()
            if ammoRemote:IsA("RemoteEvent") then
                ammoRemote:FireServer()
            elseif ammoRemote:IsA("RemoteFunction") then
                ammoRemote:InvokeServer()
            end
        end)
    end
end

-- 5. PLAYER ESP
local function CreateNameTag(character, player)
    local head = character:FindFirstChild("Head")
    if not head then return end

    local billboard = head:FindFirstChild("ESPNameTag")
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPNameTag"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 150, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.TextSize = 14
        nameLabel.Parent = billboard

        billboard.Parent = head
    end
end

local function UpdateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local highlight = char:FindFirstChild("ESPHighlight")
            local head = char:FindFirstChild("Head")
            local nameTag = head and head:FindFirstChild("ESPNameTag")

            if getgenv().ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = char
                end
                CreateNameTag(char, plr)
            else
                if highlight then highlight:Destroy() end
                if nameTag then nameTag:Destroy() end
            end
        end
    end
end

