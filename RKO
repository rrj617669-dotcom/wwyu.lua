-- [4] Advanced Drawing & ESP Manager (Fixing Respawn Bug)
local function CleanupESP(player)
    if Registry.ESPInstances[player] then
        if Registry.ESPInstances[player].Circle then
            Registry.ESPInstances[player].Circle:Remove()
        end
        if Registry.ESPInstances[player].Text then
            Registry.ESPInstances[player].Text:Remove()
        end
        Registry.ESPInstances[player] = nil
    end
end

local function InitializeESP(player)
    if player == LocalPlayer then return end
    CleanupESP(player)

    local ESPData = {}
    
    -- Circle for Head
    local HeadCircle = Drawing.new("Circle")
    HeadCircle.Visible = false
    HeadCircle.Color = Color3.fromRGB(255, 30, 30)
    HeadCircle.Thickness = 2
    HeadCircle.NumSides = 24
    HeadCircle.Filled = false
    ESPData.Circle = HeadCircle

    -- Distance Text
    local DistanceText = Drawing.new("Text")
    DistanceText.Visible = false
    DistanceText.Color = Color3.fromRGB(255, 255, 255)
    DistanceText.Size = 14
    DistanceText.Center = true
    DistanceText.Outline = true
    ESPData.Text = DistanceText

    Registry.ESPInstances[player] = ESPData

    -- Robust Respawn Hook
    local connection
    connection = player.CharacterAdded:Connect(function(newCharacter)
        task.wait(0.5)
        CleanupESP(player)
        InitializeESP(player)
    end)
    table.insert(Registry.ActiveConnections, connection)
end

-- Setup existing players
for _, p in ipairs(Players:GetPlayers()) do
    InitializeESP(p)
end

local playerAddedConn = Players.PlayerAdded:Connect(InitializeESP)
local playerRemovingConn = Players.PlayerRemoving:Connect(function(p)
    CleanupESP(p)
end)

table.insert(Registry.ActiveConnections, playerAddedConn)
table.insert(Registry.ActiveConnections, playerRemovingConn)

-- [5] Target Validation Engine
local function IsValidTarget(character)
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    
    if not humanoid or not head then return false end
    if humanoid.Health <= 0 then return false end
    
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    if targetPlayer == LocalPlayer then return false end
    
    if Settings.CheckTeam and targetPlayer and targetPlayer.Team == LocalPlayer.Team then
        return false
    end
    
    return true, head
end

-- [6] Core Triggerbot Logic (Screen-Center & Viewport Matching)
local function GetClosestHeadInScreen()
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closestHead = nil
    local shortestDistance = Settings.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local isValid, head = IsValidTarget(char)
            
            if isValid and head then
                local screenPosition, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local worldDist = (Camera.CFrame.Position - head.Position).Magnitude
                    if worldDist <= Settings.MaxDistance then
                        local screenDist = (Vector2.new(screenPosition.X, screenPosition.Y) - viewportCenter).Magnitude
                        
                        if screenDist < shortestDistance then
                            shortestDistance = screenDist
                            closestHead = head
                        end
                    end
                end
            end
        end
    end

    return closestHead
end

-- [7] Weapon Activation & Tool Fire Handler
local function ExecuteFireCommand()
    local character = LocalPlayer.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        -- البحث عن ريموتات الإطلاق الخاصة بالأسلحة أو استخدام التفعيل المباشر
        local remoteEvent = tool:FindFirstChild("OnActivate") or tool:FindFirstChild("Fire") or tool:FindFirstChild("RemoteEvent")
        
        if remoteEvent and remoteEvent:IsA("RemoteEvent") then
            pcall(function()
                remoteEvent:FireServer()
            end)
        else
            pcall(function()
                tool:Activate()
            end)
        end
    end
end

-- [8] Main RenderLoop Execution Stream
local triggerDebounce = false

RunService.RenderStepped:Connect(function()
    -- Render ESP Updates
    for player, espData in pairs(Registry.ESPInstances) do
        local char = player.Character
        local isValid, head = IsValidTarget(char)
        
        if Settings.ESPEnabled and isValid and head then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                if dist <= Settings.MaxDistance then
                    local scaleFactor = math.clamp(1000 / dist, 5, 25)
                    
                    espData.Circle.Radius = scaleFactor
                    espData.Circle.Position = Vector2.new(screenPos.X, screenPos.Y)
                    espData.Circle.Visible = true

                    espData.Text.Position = Vector2.new(screenPos.X, screenPos.Y + scaleFactor + 4)
                    espData.Text.Text = math.floor(dist) .. "m"
                    espData.Text.Visible = true
                else
                    espData.Circle.Visible = false
                    espData.Text.Visible = false
                end
            else
                espData.Circle.Visible = false
                espData.Text.Visible = false
            end
        else
            if espData.Circle then espData.Circle.Visible = false end
            if espData.Text then espData.Text.Visible = false end
        end
    end

    -- Triggerbot Execution Check
    if Settings.TriggerEnabled and not triggerDebounce then
        local targetHead = GetClosestHeadInScreen()
        
        if targetHead then
            triggerDebounce = true
            
            -- Humanized Micro-Delay
            local randomDelay = math.random(Settings.MinDelay * 1000, Settings.MaxDelay * 1000) / 1000
            task.wait(randomDelay)
            
            pcall(function()
                ExecuteFireCommand()
            end)
            
            task.wait(0.05) -- ثبات تكتيكي لتجنب الحظر والتكرار المفرط
            triggerDebounce = false
        end
    end
end)

