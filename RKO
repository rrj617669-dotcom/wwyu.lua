-- استدعاء مكتبة الواجهة Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- إضاءة نافذة التحكم
local Window = Rayfield:CreateWindow({
   Name = "Head ESP & Triggerbot | Hub",
   LoadingTitle = "جاري تفعيل النظام...",
   LoadingSubtitle = "بواسطة Assistant",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local Tab = Window:CreateTab("التحكم والـ ESP", 4483362458)

-- الإعدادات الأساسية
local Settings = {
    ESPEnabled = false,
    TriggerEnabled = false,
    MaxDistance = 200,
    MinDelay = 0.01,
    MaxDelay = 0.03,
    CheckTeam = true
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- جدول لتخزين الـ ESP الخاص باللاعبين
local espBoxes = {}

-- دالة إنشاء الـ ESP للرأس
local function createESP(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Circle")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 0, 0) -- لون أحمر ساطع على الراس
    box.Thickness = 2
    box.NumSides = 12
    box.Filled = false
    
    espBoxes[player] = box
    
    player.CharacterRemoving:Connect(function()
        if espBoxes[player] then
            espBoxes[player].Visible = false
            espBoxes[player]:Remove()
            espBoxes[player] = nil
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    createESP(p)
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p)
    if espBoxes[p] then
        espBoxes[p].Visible = false
        espBoxes[p]:Remove()
        espBoxes[p] = nil
    end
end)

-- دالة التحقق من صحة الهدف
local function isValidTarget(targetPart)
    local character = targetPart.Parent
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local enemyPlayer = Players:GetPlayerFromCharacter(character)
    
    if humanoid and humanoid.Health > 0 and enemyPlayer ~= LocalPlayer then
        if Settings.CheckTeam and enemyPlayer.Team == LocalPlayer.Team then
            return false
        end
        return true
    end
    return false
end

-- دالة إطلاق النار التلقائي المتوافقة مع أداة السلاح
local function triggerShoot()
    local humanDelay = math.random(Settings.MinDelay * 1000, Settings.MaxDelay * 1000) / 1000
    task.wait(humanDelay)
    
    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            -- استهداف مسار OnActivate أو التفعيل المباشر
            local onActivateEvent = tool:FindFirstChild("OnActivate")
            if onActivateEvent and onActivateEvent:IsA("RemoteEvent") then
                onActivateEvent:FireServer()
            else
                tool:Activate()
            end
        end
    end
end

-- التشغيل المستمر (RenderStepped للـ ESP والـ Triggerbot)
local debounce = false
RunService.RenderStepped:Connect(function()
    -- تحديث الـ ESP لكل اللاعبين
    for player, box in pairs(espBoxes) do
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        
        if Settings.ESPEnabled and head and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                -- تحديد حجم الدائرة حسب المسافة
                local distance = (Camera.CFrame.Position - head.Position).Magnitude
                if distance <= Settings.MaxDistance then
                    box.Radius = math.clamp(1500 / distance, 5, 25)
                    box.Position = Vector2.new(vector.X, vector.Y)
                    box.Visible = true
                else
                    box.Visible = false
                end
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    end
    
    -- منطق الـ Triggerbot (الطلق التلقائي على الرأس)
    if not Settings.Enabled or not Settings.TriggerEnabled or debounce then return end
    
    local cameraPos = Camera.CFrame.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local lookVector = Camera.CFrame.LookVector
    local raycastResult = Workspace:Raycast(cameraPos, lookVector * Settings.MaxDistance, raycastParams)
    
    if raycastResult and raycastResult.Instance then
        local hitPart = raycastResult.Instance
        
        -- التحقق هل الجزء الملامس لمنتصف الشاشة هو الرأس (`Head`)
        if hitPart.Name == "Head" and isValidTarget(hitPart) then
            debounce = true
            pcall(function()
                triggerShoot()
            end)
            task.wait(0.1) -- فاصل زمني بسيط لثبات الطلق
            debounce = false
        end
    end
end)

