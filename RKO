RunService.RenderStepped:Connect(function()
    if getgenv().SmartAimbotEnabled then
        local targetHead = GetBestTarget()
        if targetHead then
            -- القفل الفوري والموزون على الرأس مباشرة بدون أي تأخير مزعج
            local lockedCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position + (targetHead.AssemblyLinearVelocity * getgenv().PredictionFactor))
            Camera.CFrame = lockedCFrame
        end
    end
end)

