-- [3] Core ESP Management & Respawn Handling
local function PurgeESP(player)
    if Storage.ESPList[player] then
        if Storage.ESPList[player].Ring then
            Storage.ESPList[player].Ring:Remove()
        end
        if Storage.ESPList[player].Label then
            Storage.ESPList[player].Label:Remove()
        end
        Storage.ESPList[player] = nil
    end
end

local function BuildESP(player)
    if player == LocalPlayer then return end
    PurgeESP(player)

    local Data = {}
    
    local Ring = Drawing.new("Circle")
    Ring.Visible = false
    Ring.Color = Color3.fromRGB(0, 255, 120)
    Ring.Thickness = 1.5
    Ring.NumSides = 32
    Ring.Filled = false
    Data.Ring = Ring

    local Label = Drawing.new("Text")
    Label.Visible = false
    Label.Color = Color3.fromRGB(255, 255, 255)
    Label.Size = 13
    Label.Center = true
    Label.Outline = true
    Data.Label = Label

    Storage.ESPList[player] = Data

    local conn
    conn = player.CharacterAdded:Connect(function(char)
        task.wait(0.4)
        PurgeESP(player)
        BuildESP(player)
    end)
    table.insert(Storage.Connections, conn)
end

for _, p in ipairs(Players:GetPlayers()) do
    BuildESP(p)
end

table.insert(Storage.Connections, Players.PlayerAdded:Connect(BuildESP))
table.insert(Storage.Connections, Players.PlayerRemoving:Connect(PurgeESP))

-- [4] Target Verification Engine
local function VerifyTarget(character)
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    
    if not humanoid or not head then return false end
    if humanoid.Health <= 0 then return false end
    
    local plr = Players:GetPlayerFromCharacter(character)
    if plr == LocalPlayer then return false end
    if Config.CheckTeam and plr and plr.Team == LocalPlayer.Team then
        return false
    end
    
    return true, head
end

-- [5] Screen-Center Target Resolver (FOV Calculation)
local function GetTargetHeadInFOV()
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestHead = nil
    local minDistance = Config.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local status, headNode = VerifyTarget(char)
            
            if status and headNode then
                local screenPos, onScreen = Camera:WorldToViewportPoint(headNode.Position)
                
                if onScreen then
                    local worldDist = (Camera.CFrame.Position - headNode.Position).Magnitude
                    if worldDist <= Config.MaxDistance then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        
                        if screenDist < minDistance then
                            minDistance = screenDist
                            bestHead = headNode
                        end
                    end
                end
            end
        end
    end

    return bestHead
end

-- [6] Weapon Activation & Micro-Recoil Damping
local function TriggerAction()
    local char = LocalPlayer.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local remote = tool:FindFirstChild("OnActivate") or tool:FindFirstChild("FireEvent") or tool:FindFirstChild("RemoteEvent")
        if remote and remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer() end)
        else
            pcall(function() tool:Activate() end)
        end
    end
end

local function ApplyMicroRecoil()
    if not Config.RecoilDampener then return end
    pcall(function()
        -- تطبيق تصحيح تدريجي ناعم جداً على الكاميرا لامتصاص الارتداد بدون تأثير على الإيم
        local currentRot = Camera.CFrame
        local dampenedCFrame = currentRot * CFrame.Angles(math.rad(Config.DampeningFactor), 0, 0)
        Camera.CFrame = Camera.CFrame:Lerp(dampenedCFrame, 0.5)
    end)
end

-- [7] Main High-Performance Execution Loop
local isFiring = false

RunService.RenderStepped:Connect(function()
    -- ESP Pipeline Update
    for player, data in pairs(Storage.ESPList) do
        local char = player.Character
        local valid, head = VerifyTarget(char)
        
        if Config.ESPEnabled and valid and head then
            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                if dist <= Config.MaxDistance then
                    local scale = math.clamp(900 / dist, 4, 22)
                    
                    data.Ring.Radius = scale
                    data.Ring.Position = Vector2.new(pos.X, pos.Y)
                    data.Ring.Visible = true

                    data.Label.Position = Vector2.new(pos.X, pos.Y + scale + 3)
                    data.Label.Text = math.floor(dist) .. "m"
                    data.Label.Visible = true
                else
                    data.Ring.Visible = false
                    data.Label.Visible = false
                end
            else
                data.Ring.Visible = false
                data.Label.Visible = false
            end
        else
            if data.Ring then data.Ring.Visible = false end
            if data.Label then data.Label.Visible = false end
        end
    end

    -- Triggerbot & Recoil Control Pipeline
    if Config.TriggerEnabled and not isFiring then
        local target = GetTargetHeadInFOV()
        
        if target then
            isFiring = true
            
            local humanizedWait = math.random(Config.MinDelay * 1000, Config.MaxDelay * 1000) / 1000
            task.wait(humanizedWait)
            
            pcall(function()
                TriggerAction()
                ApplyMicroRecoil()
            end)
            
            task.wait(0.04)
            isFiring = false
        end
    end
end)

