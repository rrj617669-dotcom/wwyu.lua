-- Global Target Resolver (Core Engine)
local function GetOptimalHeadTarget()
    local ViewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local BestHeadNode = nil
    local SmallestDistance = MasterConfig.FOV

    for _, playerObj in ipairs(Players:GetPlayers()) do
        if playerObj ~= LocalPlayer and playerObj.Character then
            local humanoid = playerObj.Character:FindFirstChildOfClass("Humanoid")
            local headPart = playerObj.Character:FindFirstChild("Head")
            if humanoid and headPart and humanoid.Health > 0 then
                if not (MasterConfig.TeamCheck and playerObj.Team == LocalPlayer.Team) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(headPart.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - ViewportCenter).Magnitude
                        if screenDist < SmallestDistance then
                            SmallestDistance = screenDist
                            BestHeadNode = headPart
                        end
                    end
                end
            end
        end
    end
    return BestHeadNode
end

