---------------------------------------------------------
-- TARGET FINDER (يعمل سواء كنت ماشي أو داخل سيارة)
---------------------------------------------------------
local function GetClosestTarget()
    local closestTargetPart = nil
    local shortestDistance = getgenv().FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            -- التحقق من أن اللاعب حياً
            if humanoid and humanoid.Health > 0 then
                local targetPart = char:FindFirstChild(getgenv().AimbotTarget) or char:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closestTargetPart = targetPart
                        end
                    end
                end
            end
        end
    end
    return closestTargetPart
end

---------------------------------------------------------
-- ULTIMATE AIMBOT + SILENT AIM (داخل وخارج السيارة)
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if getgenv().UltimateAimbotEnabled then
        local target = GetClosestTarget()
        if target then
            -- 1. نظام الايم لوك والتوجيه (سواء كنت خارج او جوة السيارة والكاميرا تتحكم)
            local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, getgenv().Smoothness)

            -- 2. نظام الـ Silent Aim (توجيه الأشعة والضربات تلقائياً نحو الهدف المقفل)
            pcall(function()
                local character = LocalPlayer.Character
                if character then
                    local tool = character:FindFirstChildOfClass("Tool")
                    if tool then
                        -- البحث عن مسار الإطلاق أو النقطة البرمجية للسلاح وتوجيهها للهدف
                        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part")
                        if handle then
                            -- تعديل اتجاه الأداة محلياً لضمان إصابة الهدف بالسايلنت ايم
                            tool.GripCFrame = tool.GripCFrame:Lerp(tool.GripCFrame:inverse() * CFrame.new(0,0,0), 0.1)
                        end
                    end
                end
            end)
        end
    end
end)

