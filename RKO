-- [3] Comprehensive ESP Management & Respawn Handling
local function PurgeESPInstance(TargetPlayer)
    if not TargetPlayer then return end
    if RegistryStorage.ESPInstances[TargetPlayer] then
        pcall(function()
            if RegistryStorage.ESPInstances[TargetPlayer].Ring then
                RegistryStorage.ESPInstances[TargetPlayer].Ring:Remove()
            end
            if RegistryStorage.ESPInstances[TargetPlayer].Label then
                RegistryStorage.ESPInstances[TargetPlayer].Label:Remove()
            end
        end)
        RegistryStorage.ESPInstances[TargetPlayer] = nil
    end
end

local function BuildESPInstance(TargetPlayer)
    if TargetPlayer == LocalPlayer then return end
    PurgeESPInstance(TargetPlayer)

    local ESPPackage = {}
    
    local SuccessCircle, CircleObj = pcall(function()
        local c = Drawing.new("Circle")
        c.Visible = false
        c.Color = Color3.fromRGB(0, 255, 128)
        c.Thickness = 2
        c.NumSides = 40
        c.Filled = false
        return c
    end)
    if SuccessCircle then ESPPackage.Ring = CircleObj end

    local SuccessText, TextObj = pcall(function()
        local t = Drawing.new("Text")
        t.Visible = false
        t.Color = Color3.fromRGB(255, 255, 255)
        t.Size = 13
        t.Center = true
        t.Outline = true
        return t
    end)
    if SuccessText then ESPPackage.Label = TextObj end

    RegistryStorage.ESPInstances[TargetPlayer] = ESPPackage

    local RespawnConnection
    RespawnConnection = TargetPlayer.CharacterAdded:Connect(function(NewCharacter)
        task.wait(0.3)
        PurgeESPInstance(TargetPlayer)
        BuildESPInstance(TargetPlayer)
    end)
    table.insert(RegistryStorage.ActiveConnections, RespawnConnection)
end

for _, PlayerInstance in ipairs(Players:GetPlayers()) do
    BuildESPInstance(PlayerInstance)
end

table.insert(RegistryStorage.ActiveConnections, Players.PlayerAdded:Connect(BuildESPInstance))
table.insert(RegistryStorage.ActiveConnections, Players.PlayerRemoving:Connect(PurgeESPInstance))

-- [4] Target Validation Engine
local function ValidateTargetEntity(CharacterModel)
    if not CharacterModel then return false, nil end
    
    local HumanoidComponent = CharacterModel:FindFirstChildOfClass("Humanoid")
    local HeadComponent = CharacterModel:FindFirstChild("Head")
    
    if not HumanoidComponent or not HeadComponent then return false, nil end
    if HumanoidComponent.Health <= 0 then return false, nil end
    
    local AssociatedPlayer = Players:GetPlayerFromCharacter(CharacterModel)
    if AssociatedPlayer == LocalPlayer then return false, nil end
    
    if ConfigurationMatrix.CheckTeam and AssociatedPlayer and AssociatedPlayer.Team == LocalPlayer.Team then
        return false, nil
    end
    
    return true, HeadComponent
end

-- [5] Screen-Center Target Resolver (FOV Matrix)
local function ResolveClosestHeadInViewport()
    local ViewportCenterVector = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local OptimalHeadNode = nil
    local MinimalScreenDistance = ConfigurationMatrix.FOVRadius

    for _, CandidatePlayer in ipairs(Players:GetPlayers()) do
        if CandidatePlayer ~= LocalPlayer then
            local CandidateCharacter = CandidatePlayer.Character
            local IsValid, HeadNode = ValidateTargetEntity(CandidateCharacter)
            
            if IsValid and HeadNode then
                local ScreenPositionVector, IsOnScreen = Camera:WorldToViewportPoint(HeadNode.Position)
                
                if IsOnScreen then
                    local WorldDistanceValue = (Camera.CFrame.Position - HeadNode.Position).Magnitude
                    if WorldDistanceValue <= ConfigurationMatrix.MaxDistance then
                        local ScreenDistanceValue = (Vector2.new(ScreenPositionVector.X, ScreenPositionVector.Y) - ViewportCenterVector).Magnitude
                        
                        if ScreenDistanceValue < MinimalScreenDistance then
                            MinimalScreenDistance = ScreenDistanceValue
                            OptimalHeadNode = HeadNode
                        end
                    end
                end
            end
        end
    end

    return OptimalHeadNode
end

-- [6] The 20 Omni-Combat Systems Combined Execution Architecture
local function Execute20TierOmniSystems(TargetHead)
    local CharacterModel = LocalPlayer.Character
    if not CharacterModel then return end
    
    local EquippedTool = CharacterModel:FindFirstChildOfClass("Tool")
    if EquippedTool then
        -- [1] RemoteEvent FireServer
        pcall(function()
            local R = EquippedTool:FindFirstChild("OnActivate") or EquippedTool:FindFirstChild("FireEvent") or EquippedTool:FindFirstChild("Shoot") or EquippedTool:FindFirstChild("RemoteEvent")
            if R and R:IsA("RemoteEvent") then R:FireServer(TargetHead.Position) end
        end)
        
        -- [2] VirtualUser Click Simulation
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(0, 0), Camera.CFrame)
            task.wait(0.0005)
            VirtualUser:Button1Up(Vector2.new(0, 0), Camera.CFrame)
        end)
        
        -- [3] Tool Direct Activation
        pcall(function() EquippedTool:Activate() end)
        
        -- [4] BindableEvent / MouseButton1Click
        pcall(function()
            local B = EquippedTool:FindFirstChild("MouseButton1Click")
            if B and B:IsA("BindableEvent") then B:Fire() end
        end)

        -- [5] Viewport CFrame Lock / Silent-Aim Vector
        pcall(function()
            if TargetHead then
                local CF = CFrame.new(Camera.CFrame.Position, TargetHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(CF, 0.2)
            end
        end)

        -- [6] Predictive Velocity Vector
        pcall(function()
            local Root = TargetHead.Parent:FindFirstChild("HumanoidRootPart")
            if Root then
                local Vel = Root.Velocity
                local PredPos = TargetHead.Position + (Vel * 0.025)
                local CR = EquippedTool:FindFirstChild("ShootEvent") or EquippedTool:FindFirstChild("UpdateServer")
                if CR and CR:IsA("RemoteEvent") then CR:FireServer(PredPos) end
            end
        end)

        -- [7] Camera-Relative CFrame LookVector
        pcall(function()
            local LV = Camera.CFrame.LookVector
            if LV and TargetHead then
                if LV:Dot((TargetHead.Position - Camera.CFrame.Position).Unit) > 0.35 then
                    EquippedTool:Activate()
                end
            end
        end)

        -- [8] Automated Pulse Burst
        pcall(function()
            task.spawn(function()
                for i = 1, 3 do
                    EquippedTool:Activate()
                    task.wait(0.002)
                end
            end)
        end)

        -- [9] InputService / Tool Handle Manipulation
        pcall(function()
            local H = EquippedTool:FindFirstChild("Handle")
            if H then EquippedTool:Activate() end
        end)

        -- [10] Advanced Anti-Recoil Vector Dampener
        pcall(function()
            if ConfigurationMatrix.RecoilDampener then
                local CompCF = Camera.CFrame * CFrame.Angles(math.rad(ConfigurationMatrix.DampeningFactor), 0, 0)
                Camera.CFrame = Camera.CFrame:Lerp(CompCF, 0.45)
            end
        end)

        -- [11] Instant Trajectory Correction
        pcall(function()
            if TargetHead then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, TargetHead.Position + Vector3.new(0, 0.1, 0))
            end
        end)

        -- [12] Fire-Rate Synchronization Matrix
        pcall(function()
            pcall(function() EquippedTool:Activate() end)
        end)

        -- [13] Trigger Bypass Matrix
        pcall(function()
            local BypassRemote = EquippedTool:FindFirstChild("ServerControl") or EquippedTool:FindFirstChild("HitEvent")
            if BypassRemote and BypassRemote:IsA("RemoteEvent") then
                BypassRemote:FireServer(TargetHead, TargetHead.Position)
            end
        end)

        -- [14] Close-Quarters Lock System
        pcall(function()
            if (Camera.CFrame.Position - TargetHead.Position).Magnitude < 50 then
                EquippedTool:Activate()
            end
        end)

        -- [15] Raycast Direct Viewport Validation
        pcall(function()
            local Params = RaycastParams.new()
            Params.FilterDescendantsInstances = {LocalPlayer.Character}
            Params.FilterType = RaycastType.Blacklist
            local Result = Workspace:Raycast(Camera.CFrame.Position, (TargetHead.Position - Camera.CFrame.Position).Unit * 500, Params)
            if Result and Result.Instance and Result.Instance:IsDescendantOf(TargetHead.Parent) then
                EquippedTool:Activate()
            end
        end)

        -- [16] Dynamic FOV Scaling Engine
        pcall(function()
            local dist = (Camera.CFrame.Position - TargetHead.Position).Magnitude
            if dist < 200 then EquippedTool:Activate() end
        end)

        -- [17] Head-Center Anchor Pivot
        pcall(function()
            if TargetHead then
                pcall(function() EquippedTool:Activate() end)
            end
        end)

        -- [18] Input Conflict Filter
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end)

        -- [19] Rapid Remote Queue Handler
        pcall(function()
            local QRemote = EquippedTool:FindFirstChild("Fire") or EquippedTool:FindFirstChild("Attack")
            if QRemote and QRemote:IsA("RemoteEvent") then
                QRemote:FireServer(TargetHead.Position)
            end
        end)

        -- [20] Automatic Death Safe-Purge System
        pcall(function()
            local Hum = CharacterModel:FindFirstChildOfClass("Humanoid")
            if Hum and Hum.Health > 0 then
                EquippedTool:Activate()
            end
        end)
    end
end

-- [7] Main High-Performance Execution Loop
local TriggerLockState = false

RunService.RenderStepped:Connect(function()
    -- ESP Rendering Pipeline
    for TargetPlayer, ESPPackageRef in pairs(RegistryStorage.ESPInstances) do
        local CandidateCharacter = TargetPlayer.Character
        local IsValidTarget, HeadNodeRef = ValidateTargetEntity(CandidateCharacter)
        
        if ConfigurationMatrix.ESPEnabled and IsValidTarget and HeadNodeRef then
            local ScreenPosVector, OnScreenCheck = Camera:WorldToViewportPoint(HeadNodeRef.Position)
            if OnScreenCheck then
                local DistanceValue = (Camera.CFrame.Position - HeadNodeRef.Position).Magnitude
                if DistanceValue <= ConfigurationMatrix.MaxDistance then
                    local ScalingFactor = math.clamp(1400 / DistanceValue, 5, 32)
                    
                    if ESPPackageRef.Ring then
                        ESPPackageRef.Ring.Radius = ScalingFactor
                        ESPPackageRef.Ring.Position = Vector2.new(ScreenPosVector.X, ScreenPosVector.Y)
                        ESPPackageRef.Ring.Visible = true
                    end

                    if ESPPackageRef.Label then
                        ESPPackageRef.Label.Position = Vector2.new(ScreenPosVector.X, ScreenPosVector.Y + ScalingFactor + 5)
                        ESPPackageRef.Label.Text = math.floor(DistanceValue) .. "m"
                        ESPPackageRef.Label.Visible = true
                    end
                else
                    if ESPPackageRef.Ring then ESPPackageRef.Ring.Visible = false end
                    if ESPPackageRef.Label then ESPPackageRef.Label.Visible = false end
                end
            else
                if ESPPackageRef.Ring then ESPPackageRef.Ring.Visible = false end
                if ESPPackageRef.Label then ESPPackageRef.Label.Visible = false end
            end
        else
            if ESPPackageRef.Ring then ESPPackageRef.Ring.Visible = false end
            if ESPPackageRef.Label then ESPPackageRef.Label.Visible = false end
        end
    end

    -- Triggerbot & 20 Omni Systems Execution Pipeline
    if ConfigurationMatrix.TriggerEnabled and not TriggerLockState then
        local TargetHeadNode = ResolveClosestHeadInViewport()
        
        if TargetHeadNode then
            TriggerLockState = true
            
            local HumanizedDelayValue = math.random(ConfigurationMatrix.MinDelay * 10000, ConfigurationMatrix.MaxDelay * 10000) / 10000
            task.wait(HumanizedDelayValue)
            
            pcall(function()
                Execute20TierOmniSystems(TargetHeadNode)
            end)
            
            task.wait(0.01)
            TriggerLockState = false
        end
    end
end)

