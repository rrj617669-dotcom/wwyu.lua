---------------------------------------------------------
-- WEAPON TRIGGER LOGIC
---------------------------------------------------------
local function ActivateTool()
    local character = LocalPlayer.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    -- 1. المحاولة عبر تفعيل السلاح المباشر (Tool:Activate)
    pcall(function()
        tool:Activate()
    end)

    -- 2. المحاولة عبر الأسطر المكتشفة داخل السلاح (OnActivate)
    local onActivate = tool:FindFirstChild("OnActivate")
    if onActivate then
        pcall(function()
            if onActivate:IsA("RemoteEvent") then
                onActivate:FireServer()
            elseif onActivate:IsA("BindableEvent") then
                onActivate:Fire()
            end
        end)
    end
end

-- Toggle Control
